%na potrzeby pionowego symbolu mikro 
\usepackage{scalerel}
\newsavebox{\fooboxMU}
\newcommand{\slantbox}[2][0]{\colorlet{slantcolor}{.}\mbox{%
        \sbox{\fooboxMU}{\color{slantcolor}#2}%
        \hskip\wd\fooboxMU%
        \pdfsave%
        \pdfsetmatrix{1 0 #1 1}%
        \llap{\usebox{\fooboxMU}}%
        \pdfrestore%
}}
\newcommand\unslant[2][-.2]{%
  \mkern1mu%
  \ThisStyle{\slantbox[#1]{$\SavedStyle#2$}}%
  \mkern-1mu%
}


